# ==============================================================================
# Portfolio Backend Environment Configuration
# ==============================================================================
# Server Port & CORS
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# MongoDB Connection String (Backend runs with fallback mode if MongoDB is offline)
MONGO_URI=mongodb://127.0.0.1:27017/portfolio

# ==============================================================================
# SMTP / Gmail Configuration
# ==============================================================================
# To send REAL emails using your Gmail account:
# 1. Go to your Google Account security settings: https://myaccount.google.com/security
# 2. Ensure "2-Step Verification" is turned ON.
# 3. Go to App Passwords: https://myaccount.google.com/apppasswords
# 4. Create a new App Password (e.g. Name: "Portfolio Contact Form").
# 5. Google will generate a 16-character code (e.g., "abcd efgh ijkl mnop").
#    Copy it into SMTP_PASS below. Spaces are automatically stripped by the server.
#
# NOTE: Never use your main Google account password. Only use the App Password.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=kushwahhemant766@gmail.com
SMTP_PASS=your-16-char-app-password

# Email Delivery Addresses
MAIL_TO=kushwahhemant766@gmail.com
MAIL_FROM=kushwahhemant766@gmail.com

# Auto-Reply to Visitor (true / false)
AUTO_REPLY=true
